.ghtoken
node_modules/
__pycache__/

# regenerable screenshots (test suites & probes write these)
shots/*.png

# transient spawn output (regenerated by 'spawn')
training/rafzzer_candidate.json

# probe run reports & their screenshots (regenerable by test/speedrun/*.mjs)
test/speedrun/runs/
uploads/

# env-relay: the payload zip is committed to relay/ (tracked) so the sandbox can
# fetch it over git — blob.core.windows.net (the Actions-artifact host) is blocked.
# The relay's own fresh logs and any stray archives stay untracked.
relay_debug.txt
relay_status.txt
relay/*.part
